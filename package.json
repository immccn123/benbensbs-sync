{
  "name": "benbensbs-sync",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "ts-patch install && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "devDependencies": {
    "@deno/svelte-adapter": "^0.2.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@typia/unplugin": "^12.1.1",
    "daisyui": "^5.7.16",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.9",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "ts-patch": "^3.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.8",
    "marked": "^18.0.9",
    "nanoid": "^6.0.1",
    "typia": "^12.1.1"
  }
}